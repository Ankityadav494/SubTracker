PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/subtracker
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRE=7d
CLIENT_URL=http://localhost:5173

# Email (Gmail app password, SendGrid SMTP, etc.)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=SubTracker <your-email@gmail.com>

REMINDER_DAYS_BEFORE=3
REMINDER_CRON=0 9 * * *

# OAuth (optional)
GOOGLE_CLIENT_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
