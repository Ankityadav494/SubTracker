PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/subtracker
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRE=7d
CLIENT_URL=http://localhost:5173

# Email — required for OTP signup + renewal reminders
# Works with Brevo, Gmail, SendGrid, etc. (any SMTP provider)

# --- Brevo (recommended) ---
# 1. https://app.brevo.com → Settings → SMTP & API → SMTP
# 2. Create SMTP key; verify a sender (Settings → Senders)
# 3. Use your Brevo login email as EMAIL_USER and the SMTP key as EMAIL_PASS
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=your-brevo-login@email.com
EMAIL_PASS=your-brevo-smtp-key
EMAIL_FROM=SubTracker <sender@yourdomain.com>

# --- Gmail (alternative) ---
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-gmail-app-password
# EMAIL_FROM=SubTracker <your-email@gmail.com>

# Renewal reminder emails (per-user days in Settings; cron runs daily)
REMINDER_DAYS_BEFORE=3
REMINDER_CRON=0 9 * * *

# Gemini AI (chatbot) — put key in backend/.env ONLY (never VITE_ in frontend)
GEMINI_API_KEY=
# Use gemini-2.5-flash (gemini-2.0-flash often has no free-tier quota)
GEMINI_MODEL=gemini-2.5-flash

# OAuth (optional)
GOOGLE_CLIENT_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
